############################################
#  APPLICATION CORE
############################################

# Az alkalmazás neve (megjelenik pl. emailben, title-ben)
APP_NAME="Focus CMS - Demo"

# Környezet: local | production | staging | testing
APP_ENV=local

# Laravel generált kulcs (php artisan key:generate)
APP_KEY=

# Debug mód (production-ben false!)
APP_DEBUG=true

# Laravel Debugbar engedélyezése (csak local)
DEBUGBAR_ENABLED=true

# Időzóna
APP_TIMEZONE="Europe/Budapest"

# Docker URL + port
APP_URL=http://0.0.0.0:90
APP_PORT=90


############################################
#  LOCALIZATION
############################################

# Alapértelmezett nyelv
APP_LOCALE=hu

# Fallback nyelv
APP_FALLBACK_LOCALE=hu

# Faker locale (seedeléshez)
APP_FAKER_LOCALE=hu_HU


############################################
#  FILESYSTEM
############################################

# Default disk (config/filesystems.php)
FILESYSTEM_DISK=public

APP_MULTILANG=true
APP_SUPPORTED_LOCALES=hu,en,de

############################################
#  FILE UPLOAD CONFIG
############################################

# Engedélyezett fájl kiterjesztések
ALLOWED_UPLOADED_FILES_MIMES=svg,ico,jpg,jpeg,png,webp,bmp,gif,txt,pdf,doc,docx,odt,xls,xlsx,ods,csv,ppt,pptx,odp,zip,7z,rar,arj,mp3,wav,flac,aac,ogg,mp4,avi,mkv,webm,mov,webmanifest,json

# Engedélyezett MIME típusok
ALLOWED_UPLOADED_FILES_MIMETYPES=image/svg+xml,image/x-icon,image/vnd.microsoft.icon,image/jpeg,image/png,image/webp,image/bmp,image/gif,text/plain,application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.oasis.opendocument.text,application/vnd.ms-excel,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,application/vnd.oasis.opendocument.spreadsheet,text/csv,application/vnd.ms-powerpoint,application/vnd.openxmlformats-officedocument.presentationml.presentation,application/vnd.oasis.opendocument.presentation,application/zip,application/x-7z-compressed,application/x-rar-compressed,application/x-arj,video/mp4,video/x-msvideo,video/x-matroska,video/webm,video/quicktime,audio/mpeg,audio/wav,audio/flac,audio/aac,audio/ogg,application/manifest+json,application/json

# Csak képek (pl. featured image)
ALLOWED_UPLOADED_IMAGES_MIMES=svg,ico,jpg,jpeg,png,webp,bmp,gif
ALLOWED_UPLOADED_IMAGES_MIMETYPES=image/svg+xml,image/x-icon,image/vnd.microsoft.icon,image/jpeg,image/png,image/webp,image/bmp,image/gif

# Max fájlméret KB-ban (102400 KB = 100 MB)
ALLOWED_UPLOADED_FILES_MAX_SIZE=102400


############################################
#  MAINTENANCE MODE
############################################

# file | cache | database
APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database


############################################
#  PERFORMANCE
############################################

# PHP beépített szerver worker száma
PHP_CLI_SERVER_WORKERS=4

# Bcrypt rounds (password hash erősség)
BCRYPT_ROUNDS=12


############################################
#  LOGGING
############################################

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug


############################################
#  DATABASE (Docker MariaDB)
############################################

DB_CONNECTION=mariadb
DB_HOST=focuscmsdemo-db
DB_PORT=3306
DB_DATABASE=focuscmsdemo
DB_USERNAME=focuscmsdemo
DB_PASSWORD=focuscmsdemo


############################################
#  SESSION
############################################

# file | cookie | database | redis
SESSION_DRIVER=database

# Percben (10080 = 7 nap)
SESSION_LIFETIME=10080

SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=false
SESSION_SAME_SITE=lax


############################################
#  QUEUE & BROADCAST
############################################

BROADCAST_CONNECTION=log
QUEUE_CONNECTION=database


############################################
#  CACHE
############################################

CACHE_STORE=database
CACHE_PREFIX=

# MEMCACHED_HOST=127.0.0.1


############################################
#  REDIS (ha később kellene)
############################################

# REDIS_CLIENT=phpredis
# REDIS_HOST=127.0.0.1
# REDIS_PASSWORD=null
# REDIS_PORT=6379


############################################
#  MAIL (Docker - Mailhog)
############################################

MAIL_MAILER=smtp
MAIL_HOST=focuscmsdemo-mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null

MAIL_FROM_ADDRESS=noreply@focuscms.local
MAIL_FROM_NAME="Focus CMS - Demo"
SMTP_FROM_ADDRESS=noreply@focuscms.local
SMTP_FROM_NAME="Focus CMS - Demo"


############################################
#  SMTP - Brevo példa
############################################

# MAIL_MAILER=smtp
# MAIL_FROM_ADDRESS=""
# MAIL_FROM_NAME="${APP_NAME}"
# MAIL_HOST=smtp-relay.brevo.com
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_ENCRYPTION=tls
# SMTP_FROM_ADDRESS=
# SMTP_FROM_NAME=


############################################
#  MAILJET API (opcionális)
############################################

# MAILJET_APIKEY=
# MAILJET_APISECRET=
# MAILJET_FROM_ADDRESS=""
# MAILJET_FROM_NAME="Focus CMS - Demo (Mailjet)"


############################################
#  GOOGLE RECAPTCHA v3
############################################

RECAPTCHA_ENABLED=false
RECAPTCHA_SKIP_ENV=local,testing
#RECAPTCHA_SKIP=true
RECAPTCHA_SITE_KEY=""
RECAPTCHA_SECRET_KEY=""
RECAPTCHA_THRESHOLD=0.5


############################################
#  CLOUDFLARE TURNSTILE
############################################

CLOUDFARE_ENABLED=false
CLOUDFARE_SKIP_ENV=local,testing
CLOUDFARE_SITE_KEY=
CLOUDFARE_SECRET_KEY=


############################################
#  AWS S3
############################################

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false


############################################
#  VITE
############################################

VITE_APP_NAME="${APP_NAME}"