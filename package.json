{
    "name": "focus-cms-assets",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "install:admin": "npm install --prefix tools/admin/generated",
        "install:front": "npm install --prefix tools/front/generated",
        "install:all": "npm run install:admin && npm run install:front",
        "dev:admin": "npm --prefix tools/admin/generated run dev",
        "dev:front": "npm --prefix tools/front/generated run dev",
        "dev:all": "concurrently --kill-others-on-fail --names \"ADMIN,FRONT\" --prefix-colors \"blue,green\" \"npm run dev:admin\" \"npm run dev:front\"",
        "build:admin": "npm --prefix tools/admin/generated run build",
        "build:front": "npm --prefix tools/front/generated run build",
        "build:all": "npm run build:admin && npm run build:front"
    },
    "devDependencies": {
        "concurrently": "^9.0.0"
    }
}
